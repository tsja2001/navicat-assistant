<Window x:Class="NavicatTextProbe.TaskbarSuggestionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assistant 任务栏建议"
        Width="640" Height="44" MinWidth="200" MinHeight="30"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        Focusable="False" Cursor="SizeAll" Background="Transparent" TextOptions.TextRenderingMode="Grayscale">
    <Border x:Name="SuggestionBorder" Background="#202020" CornerRadius="0"
            ClipToBounds="True" BorderThickness="0">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="提示条外观…" Click="OpenSettingsMenuItem_OnClick" />
                <MenuItem Header="回到任务栏" Click="DockMenuItem_OnClick" />
                <MenuItem Header="滚轮阅读 · Win+PageUp / Win+PageDown 翻页" IsEnabled="False" />
                <MenuItem Header="暂停全部功能" Click="HideMenuItem_OnClick" />
            </ContextMenu>
        </Border.ContextMenu>
        <Grid>
          <Grid Margin="10,3,14,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="27" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="PageIndicatorColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
                <Ellipse x:Name="MainStatusDot" Width="5" Height="5" Margin="0,0,0,2" Fill="#3498DB" ToolTip="主流程：等待" />
                <Ellipse x:Name="DatabaseStatusDot" Width="5" Height="5" Margin="0,0,0,2" Fill="#7F8C8D" ToolTip="数据库增强：未使用" />
                <Ellipse x:Name="GuidedTypingStatusDot" Width="5" Height="5" Fill="#7F8C8D" ToolTip="受控代打：关闭" />
            </StackPanel>
            <ScrollViewer x:Name="SuggestionScroller" Grid.Column="1"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto" Cursor="Arrow"
                          CanContentScroll="False"
                          Focusable="False"
                          VerticalAlignment="Stretch">
                <TextBlock x:Name="SuggestionText" FontFamily="Cascadia Mono, Consolas"
                           TextWrapping="Wrap"
                           VerticalAlignment="Top" Foreground="White"
                           Text="等待 SQL 建议……" />
            </ScrollViewer>
            <TextBlock x:Name="PageIndicator" Grid.Column="2" Margin="6,0,0,0"
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       Foreground="White" Opacity="0.72"
                       TextAlignment="Right" Visibility="Collapsed" />
          </Grid>
          <Border x:Name="TopLeftGrip" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top"
                  Background="Transparent" Cursor="SizeNWSE" ToolTip="拖动此角调整宽度和高度">
              <Path Data="M 2,8 L 8,2 M 2,4 L 4,2" Stroke="{Binding Foreground, ElementName=SuggestionText}" Opacity="0.75" />
          </Border>
          <Border x:Name="BottomRightGrip" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  Background="Transparent" Cursor="SizeNWSE" ToolTip="拖动此角调整宽度和高度">
              <Path Data="M 3,10 L 10,3 M 7,10 L 10,7" Stroke="{Binding Foreground, ElementName=SuggestionText}" Opacity="0.75" />
          </Border>
        </Grid>
    </Border>
</Window>
