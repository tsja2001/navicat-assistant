<Window x:Class="NavicatTextProbe.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assistant 设置"
        Width="820" Height="720" MinWidth="700" MinHeight="580"
        WindowStartupLocation="CenterOwner" Background="#F4F6F8">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl>
            <TabItem Header="AI 与提示词">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="DeepSeek API" />
                        <TextBlock x:Name="ApiKeyStatusText" Margin="0,6,0,12" Foreground="#667788" />

                        <TextBlock FontWeight="SemiBold" Text="新 API Key" />
                        <PasswordBox x:Name="ApiKeyPasswordBox" Margin="0,5,0,5" Height="32" Padding="8,4" />
                        <TextBlock Foreground="#7B241C" TextWrapping="Wrap"
                                   Text="留空表示保留现有 Key。Key 只保存到 Windows 凭据管理器，不写入项目文件或日志。" />
                        <CheckBox x:Name="ClearApiKeyCheckBox" Margin="0,9,0,16" Content="删除已保存的 API Key" />

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="API 地址" />
                                <TextBox x:Name="ApiBaseUrlTextBox" Margin="0,5,0,0" Height="31" Padding="7,3" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock FontWeight="SemiBold" Text="模型" />
                                <TextBox x:Name="ModelTextBox" Margin="0,5,0,0" Height="31" Padding="7,3" />
                            </StackPanel>
                        </Grid>

                        <CheckBox x:Name="AiEnabledCheckBox" Margin="0,0,0,14" FontWeight="SemiBold"
                                  Content="启用自动 AI 预测" />

                        <Separator Margin="0,2,0,14" />
                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="屏幕 OCR · DeepSeek Flash" />
                        <TextBlock Margin="0,6,0,12" TextWrapping="Wrap"
                                   Text="在主窗口输入 OCR 密钥。按识别快捷键时，截图会发送给 DeepSeek 识别并答题。" />
                        <CheckBox x:Name="VisionEnabledCheckBox" Margin="0,0,0,16" FontWeight="SemiBold"
                                  Content="启用主动屏幕识别" />
                        <StackPanel Margin="0,0,0,16" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="截图范围" />
                            <ComboBox x:Name="VisionCaptureScopeComboBox" Width="180" Height="30" Margin="12,0,0,0"
                                      SelectedValuePath="Tag">
                                <ComboBoxItem Tag="CurrentMonitor" Content="当前光标所在显示器" />
                                <ComboBoxItem Tag="ForegroundWindow" Content="仅前台窗口" />
                            </ComboBox>
                        </StackPanel>

                        <Separator Margin="0,2,0,14" />
                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="智谱 GLM 冗余（DeepSeek 超时兜底）" />
                        <TextBlock Margin="0,6,0,12" Foreground="#667788" TextWrapping="Wrap"
                                   Text="DeepSeek 请求超时或网络不可达时，使用下方的智谱 API Key 调用 GLM 模型重试一次。未保存智谱 Key 或关闭该选项时不启用。" />
                        <TextBlock x:Name="ZhipuApiKeyStatusText" Margin="0,6,0,12" Foreground="#667788" />
                        <TextBlock FontWeight="SemiBold" Text="新智谱 API Key" />
                        <PasswordBox x:Name="ZhipuApiKeyPasswordBox" Margin="0,5,0,5" Height="32" Padding="8,4" />
                        <CheckBox x:Name="ClearZhipuApiKeyCheckBox" Margin="0,9,0,12" Content="删除已保存的智谱 API Key" />
                        <CheckBox x:Name="FallbackEnabledCheckBox" Margin="0,0,0,12" FontWeight="SemiBold"
                                  Content="启用 DeepSeek 超时自动切换智谱 GLM" />
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="冗余 API 地址" />
                                <TextBox x:Name="FallbackApiBaseUrlTextBox" Margin="0,5,0,0" Height="31" Padding="7,3" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock FontWeight="SemiBold" Text="冗余模型" />
                                <TextBox x:Name="FallbackModelTextBox" Margin="0,5,0,0" Height="31" Padding="7,3" />
                            </StackPanel>
                        </Grid>

                        <TextBlock FontWeight="SemiBold" Text="全局补充提示词" />
                        <TextBlock Margin="0,4,0,5" Foreground="#667788" TextWrapping="Wrap"
                                   Text="内置系统提示词已经负责 SQL Copilot、新手补全和错误诊断；这里填写你的业务、命名和输出偏好。" />
                        <TextBox x:Name="GlobalPromptTextBox" MinHeight="220" Padding="9"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" />

                        <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="输入停止后等待" />
                            <TextBox x:Name="DebounceTextBox" Width="80" Height="29" Margin="10,0,7,0" Padding="6,2" />
                            <TextBlock VerticalAlignment="Center" Text="毫秒（新起一行会更快触发）" />
                        </StackPanel>
                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="普通请求最短间隔" />
                            <TextBox x:Name="MinimumIntervalTextBox" Width="80" Height="29" Margin="10,0,7,0" Padding="6,2" />
                            <TextBlock VerticalAlignment="Center" Text="毫秒（避免慢速打字时连续请求）" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="数据库增强">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="MySQL 只读数据增强" />
                        <TextBlock Margin="0,6,0,14" Foreground="#667788" TextWrapping="Wrap"
                                   Text="Assistant 会把缓存的可访问数据库目录（库、表、字段、键和外键关系）发送给 DeepSeek；AI 按当前 SQL 自主决定是否调用实时只读查询工具，无需特殊注释。不会预取业务行，查询仍受只读事务、超时、行数和结果大小限制。" />
                        <CheckBox x:Name="DatabaseEnabledCheckBox" Margin="0,0,0,14" FontWeight="SemiBold"
                                  Content="启用 AI 自主只读数据库工具" />

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" /><ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" /><ColumnDefinition Width="190" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="显示名称" />
                            <TextBox x:Name="DatabaseDisplayNameTextBox" Grid.Column="1" Margin="0,4,16,4" Padding="7,3" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="优先数据库（可空）" />
                            <TextBox x:Name="DatabaseNameTextBox" Grid.Column="3" Margin="0,4" Padding="7,3" />

                            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="主机" />
                            <TextBox x:Name="DatabaseHostTextBox" Grid.Row="1" Grid.Column="1" Margin="0,4,16,4" Padding="7,3" />
                            <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Text="端口" />
                            <TextBox x:Name="DatabasePortTextBox" Grid.Row="1" Grid.Column="3" Margin="0,4" Padding="7,3" />

                            <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="用户名" />
                            <TextBox x:Name="DatabaseUsernameTextBox" Grid.Row="2" Grid.Column="1" Margin="0,4,16,4" Padding="7,3" />
                            <TextBlock Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" Text="TLS 模式" />
                            <ComboBox x:Name="DatabaseSslModeComboBox" Grid.Row="2" Grid.Column="3" Margin="0,4" Height="30" SelectedValuePath="Tag">
                                <ComboBoxItem Tag="Preferred" Content="优先 TLS" />
                                <ComboBoxItem Tag="Required" Content="必须 TLS" />
                                <ComboBoxItem Tag="VerifyCA" Content="验证 CA" />
                                <ComboBoxItem Tag="VerifyFull" Content="完整验证" />
                                <ComboBoxItem Tag="Disabled" Content="关闭 TLS" />
                            </ComboBox>

                            <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="新密码" />
                            <PasswordBox x:Name="DatabasePasswordBox" Grid.Row="3" Grid.Column="1" Margin="0,4,16,4" Padding="7,3" />
                            <CheckBox x:Name="ClearDatabasePasswordCheckBox" Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2"
                                      VerticalAlignment="Center" Content="删除已保存密码" />

                            <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="连接/查询超时" />
                            <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,4,16,4" Orientation="Horizontal">
                                <TextBox x:Name="DatabaseConnectTimeoutTextBox" Width="55" Padding="7,3" />
                                <TextBlock Margin="6,0,12,0" VerticalAlignment="Center" Text="秒 /" />
                                <TextBox x:Name="DatabaseQueryTimeoutTextBox" Width="55" Padding="7,3" />
                                <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="秒" />
                            </StackPanel>
                            <TextBlock Grid.Row="4" Grid.Column="2" VerticalAlignment="Center" Text="最大行数" />
                            <TextBox x:Name="DatabaseMaximumRowsTextBox" Grid.Row="4" Grid.Column="3" Margin="0,4" Padding="7,3" />

                            <TextBlock Grid.Row="5" VerticalAlignment="Center" Text="最大结果" />
                            <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,4,16,4" Orientation="Horizontal">
                                <TextBox x:Name="DatabaseMaximumKilobytesTextBox" Width="70" Padding="7,3" />
                                <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" Text="KiB" />
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="DatabasePasswordStatusText" Margin="0,12,0,8" Foreground="#667788" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="TestDatabaseButton" Width="120" Height="32" Click="TestDatabaseButton_OnClick" Content="测试只读连接" />
                            <TextBlock x:Name="DatabaseTestStatusText" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#405365" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Margin="0,14,0,0" Foreground="#7B241C" TextWrapping="Wrap"
                                   Text="允许使用现有账号并读取其可见的多个业务库，不按权限高低阻止连接；但 Assistant 不会把 INSERT、UPDATE、DELETE、DDL、多语句、锁或文件操作发送到数据库。密码只进入 Windows 凭据管理器。" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="AppearanceTab" Header="展示与样式">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <CheckBox x:Name="AssistantEnabledCheckBox" FontSize="15" FontWeight="SemiBold"
                                  Content="启用 Assistant" />
                        <TextBlock Margin="22,5,0,18" Foreground="#667788" TextWrapping="Wrap"
                                   Text="关闭时会停止探测、AI 请求、键盘兜底、任务栏提示和手机服务；Ctrl+Alt+S 可随时整体开启或关闭。" />

                        <Separator />
                        <CheckBox x:Name="TaskbarEnabledCheckBox" Margin="0,20,0,0" FontSize="15" FontWeight="SemiBold"
                                  Content="启用悬浮提示条" />
                        <TextBlock Margin="22,5,0,0" Foreground="#667788" TextWrapping="Wrap"
                                   Text="滚动鼠标滚轮可看完整建议。拖动文字可移动提示条，拖动左上角或右下角可调整大小。" />
                        <Grid Margin="22,10,0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="字号" />
                            <TextBox x:Name="TaskbarFontSizeTextBox" Grid.Column="1" Padding="6,2" />
                            <TextBlock Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Text="文字颜色" />
                            <TextBox x:Name="TaskbarForegroundTextBox" Grid.Column="3" Padding="6,2" />
                            <TextBlock Grid.Row="1" Margin="0,8,0,0" VerticalAlignment="Center" Text="行高" />
                            <TextBox x:Name="TaskbarLineHeightTextBox" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Padding="6,2" />
                            <Button Grid.Row="1" Grid.Column="2" Margin="12,8,8,0" Content="选背景颜色…" Click="ChooseBackground_OnClick" />
                            <TextBox x:Name="TaskbarBackgroundTextBox" Grid.Row="1" Grid.Column="3" Margin="0,8,0,0" Padding="6,2" />
                            <TextBlock Grid.Row="2" Margin="0,8,0,0" VerticalAlignment="Center" Text="宽度（200–1400）" />
                            <TextBox x:Name="TaskbarWidthTextBox" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Padding="6,2" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Margin="12,8,0,0" VerticalAlignment="Center" Text="悬浮高度（30–900）" />
                            <TextBox x:Name="TaskbarHeightTextBox" Grid.Row="2" Grid.Column="3" Margin="0,8,0,0" Padding="6,2" />
                        </Grid>
                        <StackPanel Margin="22,6,0,6" Orientation="Horizontal">
                            <TextBlock Width="130" VerticalAlignment="Center" Text="背景不透明度" />
                            <Slider x:Name="TaskbarOpacitySlider" Width="170" Minimum="0" Maximum="1"
                                    SmallChange="0.01" LargeChange="0.1" IsMoveToPointEnabled="True" />
                            <TextBlock Width="48" Margin="8,0" VerticalAlignment="Center"
                                       Text="{Binding Value, ElementName=TaskbarOpacitySlider, StringFormat={}{0:P0}}" />
                            <Button Content="全透明" Padding="8,2" Click="TransparentBackground_OnClick" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="手机、监听与快捷键">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <CheckBox x:Name="MobileEnabledCheckBox" FontSize="15" FontWeight="SemiBold"
                                  Content="启用局域网手机页面" />
                        <StackPanel Margin="22,10,0,18" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="端口" />
                            <TextBox x:Name="MobilePortTextBox" Width="100" Height="29" Margin="10,0" Padding="6,2" />
                            <TextBlock VerticalAlignment="Center" Text="访问令牌" />
                            <TextBox x:Name="MobileTokenTextBox" Width="180" Height="29" Margin="10,0" Padding="6,2" />
                        </StackPanel>
                        <TextBlock Margin="22,0,0,5" FontWeight="SemiBold" Text="手机页面建议样式" />
                        <Grid Margin="22,0,0,18">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/><ColumnDefinition Width="90"/><ColumnDefinition Width="100"/><ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="字号"/><TextBox x:Name="MobileFontSizeTextBox" Grid.Column="1" Padding="6,2"/>
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="行高"/><TextBox x:Name="MobileLineHeightTextBox" Grid.Column="3" Padding="6,2"/>
                            <TextBlock Grid.Row="1" Margin="0,8,0,0" VerticalAlignment="Center" Text="背景/字体色"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,8,0,0" Orientation="Horizontal">
                                <TextBox x:Name="MobileBackgroundTextBox" Width="82" Padding="6,2"/><TextBox x:Name="MobileForegroundTextBox" Width="82" Margin="8,0" Padding="6,2"/>
                                <TextBlock VerticalAlignment="Center" Text="透明度"/><TextBox x:Name="MobileOpacityTextBox" Width="70" Margin="8,0,0,0" Padding="6,2"/>
                            </StackPanel>
                        </Grid>

                        <CheckBox x:Name="KeyboardFallbackCheckBox" Margin="0,0,0,5" FontSize="15" FontWeight="SemiBold"
                                  Content="允许键盘监听兜底" />
                        <TextBlock Margin="22,0,0,20" Foreground="#7B241C" TextWrapping="Wrap"
                                   Text="默认关闭。只有 Navicat 位于前台且全文读取失败时才记录临时按键缓冲，不写原始按键日志；IME 和粘贴内容无法仅靠键盘钩子完整恢复。" />
                        <CheckBox x:Name="GuidedTypingEnabledCheckBox" Margin="0,0,0,5" FontSize="15" FontWeight="SemiBold"
                                  Content="允许受控逐字代打" />
                        <TextBlock Margin="22,0,0,20" Foreground="#7B241C" TextWrapping="Wrap"
                                   Text="默认关闭每次代打会话。仅在 Navicat 或 Word 的前台编辑位置与当前答案仍匹配时，每个普通按键输入答案的下一个文本元素；Esc 可立即退出。" />

                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="全局快捷键" />
                        <Grid Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="210" />
                                <ColumnDefinition Width="180" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="整体显示/隐藏并启停" />
                            <TextBox x:Name="AssistantHotkeyTextBox" Grid.Column="1" Padding="6,2" />
                            <TextBlock Grid.Row="1" Margin="0,8,0,0" VerticalAlignment="Center" Text="智能分析当前内容" />
                            <TextBox x:Name="SmartActionHotkeyTextBox" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Padding="6,2" />
                            <TextBlock Grid.Row="2" Margin="0,8,0,0" VerticalAlignment="Center" Text="强制当前屏幕 OCR" />
                            <TextBox x:Name="VisionScreenshotHotkeyTextBox" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Padding="6,2" />
                            <TextBlock Grid.Row="3" Margin="0,8,0,0" VerticalAlignment="Center" Text="受控逐字代打" />
                            <TextBox x:Name="GuidedTypingHotkeyTextBox" Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" Padding="6,2" />
                            <TextBlock Grid.Row="4" Margin="0,8,0,0" VerticalAlignment="Center" Text="完整答案复制到剪贴板" />
                            <TextBox x:Name="CopyFullAnswerHotkeyTextBox" Grid.Row="4" Grid.Column="1" Margin="0,8,0,0" Padding="6,2" />
                            <TextBlock Grid.Row="5" Margin="0,8,0,0" VerticalAlignment="Center" Text="回答剪贴板题目并覆盖" />
                            <TextBox x:Name="AnswerClipboardQuestionHotkeyTextBox" Grid.Row="5" Grid.Column="1" Margin="0,8,0,0" Padding="6,2" />
                            <TextBlock Grid.Row="6" Margin="0,8,0,0" VerticalAlignment="Center" Text="手机完整答案开关" />
                            <TextBox x:Name="ToggleMobileHotkeyTextBox" Grid.Row="6" Grid.Column="1" Margin="0,8,0,0" Padding="6,2" />
                            <TextBlock Grid.Row="7" Margin="0,8,0,0" VerticalAlignment="Center" Text="进阶：生成/切换 3 个候选" />
                            <TextBox x:Name="CandidateHotkeyTextBox" Grid.Row="7" Grid.Column="1" Margin="0,8,0,0" Padding="6,2" />
                            <TextBlock Grid.Row="8" Margin="0,8,0,0" VerticalAlignment="Center" Text="手机页隐私黑屏开关" />
                            <TextBox x:Name="ToggleMobilePrivacyHotkeyTextBox" Grid.Row="8" Grid.Column="1" Margin="0,8,0,0" Padding="6,2" />
                        </Grid>
                        <TextBlock Margin="0,10,0,0" Foreground="#667788" TextWrapping="Wrap"
                                   Text="Assistant 默认独占拦截这些业务快捷键：命中后不再传给钉钉等普通应用。任务栏翻页固定使用 Win+PageUp / Win+PageDown；总开关关闭后只保留整体启停键。Windows 安全界面、系统保留组合键和权限更高的程序不受此保证。" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Margin="0,14,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Width="96" Height="34" Margin="0,0,10,0" IsCancel="True" Content="取消" />
            <Button Width="110" Height="34" IsDefault="True" Click="SaveButton_OnClick" Content="保存设置" />
        </StackPanel>
    </Grid>
</Window>
