<Window x:Class="NavicatTextProbe.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assistant"
        Width="1060" Height="820" MinWidth="820" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#F3F6F8">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="25" FontWeight="SemiBold" Foreground="#17202A" Text="Assistant" />
                <TextBlock Margin="0,5,0,0" Foreground="#5D6D7E"
                           x:Name="ScreenShortcutText" Text="屏幕识别" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button MinWidth="106" Height="34" Padding="14,0" Click="AnalyzeButton_OnClick" Content="分析剪贴板" />
                <Button Margin="9,0,0,0" MinWidth="88" Height="34" Padding="14,0" Click="SettingsButton_OnClick" Content="设置" />
                <Button x:Name="ToggleButton" Margin="9,0,0,0" MinWidth="96" Height="34" Padding="14,0"
                        Click="ToggleButton_OnClick" Content="暂停全部功能" />
                <Button Margin="9,0,0,0" MinWidth="96" Height="34" Padding="14,0"
                        Click="OpenLogsButton_OnClick" Content="日志目录" />
            </StackPanel>
            <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0" VerticalAlignment="Center">
                <Label Target="{Binding ElementName=ScreenOcrKeyBox}" Content="DeepSeek OCR 密钥" VerticalAlignment="Center"/>
                <PasswordBox x:Name="ScreenOcrKeyBox" Width="210" Height="30" Padding="6,3"
                             AutomationProperties.Name="DeepSeek OCR API Key"/>
                <CheckBox x:Name="RememberScreenOcrKeyBox" Margin="12,0" VerticalAlignment="Center"
                          Content="记住密钥" ToolTip="勾选后点应用，将密钥保存到 Windows 凭据管理器。取消勾选后点应用，下次启动需重新输入。"/>
                <Button Content="应用" Padding="14,3" Click="ApplyScreenOcrKey_OnClick"/>
                <Button x:Name="DeleteScreenOcrKeyButton" Margin="8,0,0,0" Padding="10,3" Content="删除 OCR 密钥"
                        IsEnabled="False" Click="DeleteScreenOcrKey_OnClick"
                        ToolTip="删除这台电脑保存的 OCR 密钥，并清空本次使用的密钥。"/>
                <TextBlock x:Name="ScreenOcrKeyStatus" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#52616F"/>
            </WrapPanel>
        </Grid>

        <Border Grid.Row="1" Margin="0,15,0,0" Padding="12,10" CornerRadius="8"
                Background="White" BorderBrush="#D5D8DC" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,2,10,0" VerticalAlignment="Top">
                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Margin="0,0,0,3" Fill="#F39C12" ToolTip="主流程" />
                    <Ellipse x:Name="DatabaseStatusDot" Width="7" Height="7" Margin="0,0,0,3" Fill="#7F8C8D" ToolTip="数据库增强" />
                    <Ellipse x:Name="GuidedTypingStatusDot" Width="7" Height="7" Fill="#7F8C8D" ToolTip="受控代打" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="StatusText" FontWeight="SemiBold" Foreground="#273746" Text="正在启动探测器……" />
                    <TextBlock x:Name="DetailText" Margin="0,4,0,0" Foreground="#667788" TextWrapping="Wrap" Text="尚未捕获文本。" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,13,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Padding="14" CornerRadius="9" Background="#16212C" BorderBrush="#34495E" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Border Padding="7,2" CornerRadius="10" Background="#1E6F50"><TextBlock x:Name="SuggestionModeText" FontSize="11" Foreground="#D5F5E3" Text="状态"/></Border>
                        <TextBlock Margin="9,1,0,0" Foreground="#8596A6" Text="当前建议" />
                    </StackPanel>
                    <TextBlock x:Name="SuggestionDisplayText" Grid.Row="1" Margin="0,10,0,0" FontFamily="Cascadia Mono, Consolas"
                               FontSize="17" FontWeight="SemiBold" Foreground="#7DCEA0" TextWrapping="Wrap" Text="等待 Navicat SQL……" />
                    <TextBlock x:Name="SuggestionExplanationText" Grid.Row="2" Margin="0,8,0,0" Foreground="#B8C4CE" TextWrapping="Wrap" Text="Navicat 可自动预测；Word 需主动按识题快捷键。" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Padding="13" CornerRadius="9" Background="White" BorderBrush="#D5D8DC" BorderThickness="1">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Foreground="#273746" Text="输出通道" />
                    <TextBlock x:Name="AssistantStatusText" Margin="0,8,0,0" Foreground="#52616F" Text="Assistant：—" />
                    <TextBlock x:Name="TaskbarStatusText" Margin="0,5,0,0" Foreground="#52616F" Text="任务栏内建议：—" />
                    <TextBlock x:Name="CapturePrivacyText" Margin="0,5,0,0" Foreground="#52616F" TextWrapping="Wrap" />
                    <TextBlock x:Name="MobileStatusText" Margin="0,5,0,0" Foreground="#52616F" TextWrapping="Wrap" Text="手机页面：—" />
                    <WrapPanel Margin="0,8,0,0">
                        <Button Height="27" Padding="8,0" Margin="0,0,6,5" Click="OpenLocalMobilePageButton_OnClick" Content="电脑打开" />
                        <Button Height="27" Padding="8,0" Margin="0,0,6,5" Click="CopyPhoneUrlButton_OnClick" Content="复制手机地址" />
                        <Button x:Name="FirewallFixButton" Height="27" Padding="8,0" Margin="0,0,0,5" Click="FirewallFixButton_OnClick" Content="修复手机访问" />
                    </WrapPanel>
                    <TextBlock x:Name="FirewallStatusText" Margin="0,1,0,0" FontSize="11" Foreground="#7B241C" TextWrapping="Wrap" Text="防火墙：检测中……" />
                    <TextBlock x:Name="HotkeyStatusText" Margin="0,7,0,0" FontSize="11" Foreground="#7B241C" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <TabControl Grid.Row="3">
            <TabItem Header="Navicat SQL 全文">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="4,2,4,7">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock FontWeight="SemiBold" Foreground="#273746" Text="当前捕获内容" />
                        <TextBlock x:Name="LengthText" Grid.Column="1" Foreground="#667788" Text="0 字符" />
                    </Grid>
                    <Border Grid.Row="1" Background="#18212B" CornerRadius="7" BorderBrush="#34495E" BorderThickness="1">
                        <TextBox x:Name="SqlTextBox" Margin="1" Padding="13" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True"
                                 IsUndoEnabled="False"
                                 TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Cascadia Mono, Consolas" FontSize="14" Foreground="#EAECEE" Background="#18212B"
                                 BorderThickness="0" Text="等待捕获……" />
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="完整 AI 建议">
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock x:Name="SuggestionInsertLabel" FontWeight="SemiBold" Foreground="#273746" Text="可插入/替换的 SQL" />
                    <TextBox x:Name="SuggestionInsertTextBox" Grid.Row="1" Margin="0,8,0,10" Padding="12" IsReadOnly="True"
                             IsUndoEnabled="False"
                             AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="Cascadia Mono, Consolas" FontSize="14" Background="#18212B" Foreground="#EAECEE" BorderThickness="0" Text="—" />
                    <TextBlock x:Name="IssuesText" Grid.Row="2" Foreground="#7B241C" TextWrapping="Wrap" />
                </Grid>
            </TabItem>
            <TabItem x:Name="ScreenOcrTab" Header="屏幕识别原文" Visibility="Collapsed">
                <TextBox x:Name="ScreenOcrTextBox" Margin="12" Padding="12" IsReadOnly="True"
                         IsUndoEnabled="False" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         FontSize="14" Background="#18212B" Foreground="#EAECEE" BorderThickness="0" />
            </TabItem>
        </TabControl>

        <Grid Grid.Row="4" Margin="0,9,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Foreground="#7B241C" TextWrapping="Wrap"
                       Text="探测日志包含 SQL 全文；AI 开启时会整篇优先发送 SQL，超长文档才按光标附近裁剪。请勿输入密钥或禁止外发的数据。" />
            <TextBlock x:Name="LogPathText" Grid.Column="1" Margin="20,0,0,0" Foreground="#667788" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
